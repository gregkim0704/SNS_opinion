# 네이버 API 인증 정보
# 네이버 개발자 센터(https://developers.naver.com)에서 발급받으세요
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# Flask 설정
FLASK_ENV=development
FLASK_DEBUG=True

# ===== AI 블로그 자동화 앱 설정 =====

# OpenAI API (필수)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Blogger API (선택)
# Google Cloud Console에서 OAuth 2.0 클라이언트 ID 생성 후
# credentials.json 파일을 프로젝트 루트에 저장
BLOGGER_BLOG_ID=your_blog_id_here
GOOGLE_CREDENTIALS_FILE=credentials.json

# YouTube Data API (선택)
# Google Cloud Console에서 API 키 발급
YOUTUBE_API_KEY=your_youtube_api_key_here

# Meta Threads API (선택)
# Meta for Developers에서 앱 생성 후 발급
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_USER_ID=your_threads_user_id_here
